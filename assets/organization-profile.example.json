{
  "organizationName": "Example Organization",
  "appTitle": "Space Booking",
  "timeZone": "Asia/Seoul",
  "access": {
    "requireSignedInUser": true,
    "allowedDomains": ["example.org"],
    "adminEmails": ["booking-admin@example.org"]
  },
  "rooms": [
    {
      "id": "meeting-room-a",
      "name": "Meeting Room A",
      "calendarId": "replace-with-calendar-id"
    }
  ],
  "meetingCalendarId": "",
  "logging": {
    "mode": "disabled",
    "spreadsheetId": ""
  },
  "notifications": {
    "emailConfirmation": false
  },
  "management": {
    "enabled": true,
    "tokenExpiryDays": 30
  },
  "limits": {
    "maxDurationMinutes": 480,
    "maxAdvanceDays": 365,
    "maxRecurrenceCount": 52,
    "alternativeSearchDays": 7,
    "maxRequestsPerMinute": 20
  }
}
